{
  "name": "guratan",
  "version": "0.8.6",
  "description": "Tiny send tool for Google Drive",
  "author": "hankei6km <hankei6km@gmail.com> (https://github.com/hankei6km)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hankei6km/guratan.git"
  },
  "bugs": {
    "url": "https://github.com/hankei6km/guratan/issues"
  },
  "keywords": [
    "google",
    "drive"
  ],
  "main": "dist/index.js",
  "exports": "./dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "guratan": "dist/main.js"
  },
  "scripts": {
    "start": "npm run build && node dist/main.js",
    "start:ts": "node --experimental-strip-types src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-test-module-mocks --experimental-strip-types --test",
    "test:coverage": "npm run test -- --experimental-test-coverage",
    "lint:types": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist/*"
  },
  "dependencies": {
    "@googleapis/drive": "^25.0.0",
    "strip-bom-stream": "^5.0.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/yargs": "^17.0.9",
    "typescript": "^7.0.2"
  }
}
